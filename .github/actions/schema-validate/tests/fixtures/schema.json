{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["name", "count"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "count": { "type": "integer", "minimum": 1 },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
